<Window x:Class="MotionForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MotionForge.Views"
        Title="MotionForge" Height="880" Width="1500" MinHeight="620" MinWidth="1080"
        Background="{StaticResource Bg}"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">

  <DockPanel LastChildFill="True">

    <!-- ===================== строка меню ===================== -->
    <Border DockPanel.Dock="Top" Height="25" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="DocTitle" DockPanel.Dock="Right" VerticalAlignment="Center"
                   Margin="10,0,12,0" Foreground="{StaticResource TxtDim}" FontSize="10.5"
                   TextTrimming="CharacterEllipsis" MaxWidth="620" />
        <StackPanel x:Name="MenuBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0" />
      </DockPanel>
    </Border>

    <!-- ===================== строка состояния ===================== -->
    <Border DockPanel.Dock="Bottom" Height="23" Background="{StaticResource Bg2}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="True" Margin="8,0">
        <TextBlock x:Name="StatusDirty" DockPanel.Dock="Right" VerticalAlignment="Center"
                   FontSize="10.5" Foreground="{StaticResource Ok}" Margin="10,0,4,0" />
        <TextBlock x:Name="StatusZoom" DockPanel.Dock="Right" VerticalAlignment="Center"
                   FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource Txt}"
                   Margin="10,0" Cursor="Hand" ToolTip="Масштаб. Щёлкните, чтобы вернуть 100%" />
        <TextBlock x:Name="StatusCoords" DockPanel.Dock="Right" VerticalAlignment="Center"
                   FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource TxtDim}" Margin="10,0" />
        <TextBlock x:Name="StatusHint" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="10.5"
                   Foreground="{StaticResource Accent2}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
        <TextBlock x:Name="StatusMessage" VerticalAlignment="Center" FontSize="10.5" Margin="14,0,0,0"
                   Foreground="{StaticResource TxtDim}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- ===================== рабочая область ===================== -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ToolsColumn" Width="70" MinWidth="0" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="3" />
        <ColumnDefinition x:Name="RightColumn" Width="308" MinWidth="210" />
      </Grid.ColumnDefinitions>

      <!-- панель инструментов -->
      <Border x:Name="ToolsDock" Grid.Column="0" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ContentControl x:Name="ToolsHeaderHost" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="ToolsHost" />
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- центр: вкладки, сцена и таймлайн -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="25" />
          <RowDefinition Height="*" MinHeight="150" />
          <RowDefinition Height="3" />
          <RowDefinition x:Name="TimelineRow" Height="256" MinHeight="118" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
          <DockPanel LastChildFill="True">
            <StackPanel x:Name="StageBarRight" DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="6,0" />
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0" />
          </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Bg}">
          <views:StageView x:Name="Stage" ClipToBounds="True" />
        </Border>

        <GridSplitter Grid.Row="2" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource Line}" />

        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="27" />
              <RowDefinition Height="*" />
              <RowDefinition Height="21" />
            </Grid.RowDefinitions>

            <!-- строка таймлайна: путь правки и кадровые команды -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1">
              <DockPanel LastChildFill="True" Margin="6,0">
                <StackPanel x:Name="TimelineToolbarHost" DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" />
                <StackPanel x:Name="BreadcrumbHost" Orientation="Horizontal" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <!-- слои и кадры -->
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LayersColumn" Width="208" MinWidth="120" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <ScrollViewer x:Name="LayersScroll" Grid.Column="0" Background="{StaticResource Panel}"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="LayersHost" />
              </ScrollViewer>

              <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="{StaticResource Line}" />

              <ScrollViewer x:Name="TimelineScroll" Grid.Column="2" Background="{StaticResource Bg2}"
                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <views:TimelineView x:Name="Timeline" />
              </ScrollViewer>
            </Grid>

            <!-- нижняя полоса таймлайна -->
            <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0">
              <DockPanel LastChildFill="True" Margin="6,0">
                <TextBlock x:Name="TimelineSummary" DockPanel.Dock="Right" VerticalAlignment="Center"
                           FontSize="10.5" Foreground="{StaticResource TxtDim}" Margin="8,0,4,0" />
                <StackPanel x:Name="TimelineFooter" Orientation="Horizontal" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="2" Width="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{StaticResource Line}" />

      <!-- правая колонка: свойства, библиотека, образцы -->
      <Grid Grid.Column="3">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="PropertiesRow" Height="*" MinHeight="150" />
          <RowDefinition Height="3" />
          <RowDefinition x:Name="LibraryRow" Height="240" MinHeight="86" />
          <RowDefinition Height="3" />
          <RowDefinition x:Name="SwatchesRow" Height="178" MinHeight="56" />
        </Grid.RowDefinitions>

        <Grid x:Name="PropertiesDock" Grid.Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ContentControl x:Name="PropertiesHeaderHost" />
          <ScrollViewer x:Name="PropertiesBodyHost" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" />
        </Grid>
        <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource Line}" />
        <Grid x:Name="LibraryDock" Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ContentControl x:Name="LibraryHeaderHost" />
          <ContentControl x:Name="LibraryBodyHost" Grid.Row="1" />
        </Grid>
        <GridSplitter Grid.Row="3" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource Line}" />
        <Grid x:Name="SwatchesDock" Grid.Row="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ContentControl x:Name="SwatchesHeaderHost" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="SwatchesHost" />
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
